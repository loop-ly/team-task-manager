# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL / Google Cloud SQL) ---
# Local:      postgres://postgres:postgres@localhost:5432/taskmanager
# Cloud SQL:  postgres://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Cloud SQL (public IP + SSL): set DB_SSL=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskmanager
DB_SSL=false

# --- Sessions ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# Dev only: set to "memory" to keep sessions in process memory instead of PostgreSQL
# SESSION_STORE=memory
# Cookies are Secure in production by default; override only if you terminate TLS elsewhere
# COOKIE_SECURE=false

# --- CORS (only needed if the client is served from a different origin) ---
CLIENT_ORIGIN=http://localhost:5173

# --- Misc ---
BCRYPT_ROUNDS=12
AUTO_MIGRATE=true
